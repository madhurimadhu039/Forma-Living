rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{allPaths=**} { allow read: if true; allow write: if request.auth != null && request.auth.token.admin == true; }
    match /users/{uid}/{allPaths=**} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if request.auth != null && request.auth.uid == uid && request.resource.size < 5 * 1024 * 1024; }
  }
}
