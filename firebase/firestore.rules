rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /coupons/{id} { allow read, write: if isAdmin(); }
    match /users/{uid} { allow read, write: if owner(uid) || isAdmin(); }
    match /carts/{uid} { allow read, write: if owner(uid); }
    match /wishlists/{uid} { allow read, write: if owner(uid); }
    match /addresses/{id} { allow read, update, delete: if signedIn() && resource.data.uid == request.auth.uid; allow create: if signedIn() && request.resource.data.uid == request.auth.uid; }
    match /moodBoards/{id} { allow read, update, delete: if signedIn() && resource.data.uid == request.auth.uid; allow create: if signedIn() && request.resource.data.uid == request.auth.uid; }
    match /reviews/{id} { allow read: if true; allow create: if signedIn() && request.resource.data.uid == request.auth.uid; allow update, delete: if isAdmin(); }
    // Orders and payments are written ONLY by Cloud Functions (Admin SDK).
    match /orders/{id} { allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin()); allow write: if false; }
    match /payments/{id} { allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin()); allow write: if false; }
    match /inventory/{id} { allow read, write: if isAdmin(); }
  }
}
