rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /coupons/{id} { allow read, write: if isAdmin(); }
    match /users/{uid} { allow read, write: if owner(uid) || isAdmin(); }
    match /carts/{uid} { allow read, write: if owner(uid); }
    match /wishlists/{uid} { allow read, write: if owner(uid); }
    match /addresses/{id} { allow read, update, delete: if signedIn() && resource.data.uid == request.auth.uid; allow create: if signedIn() && request.resource.data.uid == request.auth.uid; }
    match /moodBoards/{id} { allow read, update, delete: if signedIn() && resource.data.uid == request.auth.uid; allow create: if signedIn() && request.resource.data.uid == request.auth.uid; }
    match /reviews/{id} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && id == request.resource.data.productId + '_' + request.auth.uid
                    && request.resource.data.keys().hasAll(['productId', 'uid', 'userName', 'rating', 'title', 'comment', 'createdAt'])
                    && request.resource.data.keys().hasOnly(['productId', 'uid', 'userName', 'rating', 'title', 'comment', 'createdAt'])
                    && request.resource.data.productId is string && request.resource.data.productId.size() >= 1 && request.resource.data.productId.size() <= 60
                    && request.resource.data.uid is string && request.resource.data.uid.size() >= 1 && request.resource.data.uid.size() <= 128
                    && request.resource.data.userName is string && request.resource.data.userName.size() >= 1 && request.resource.data.userName.size() <= 100
                    && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
                    && request.resource.data.title is string && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 100
                    && request.resource.data.comment is string && request.resource.data.comment.size() >= 10 && request.resource.data.comment.size() <= 1000
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }
    match /inquiries/{id} {
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
                    && request.resource.data.status in ['new', 'in-progress', 'resolved']
                    && request.resource.data.updatedAt == request.time;
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'subject', 'message', 'status', 'createdAt', 'honeypot'])
                    && request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'status', 'createdAt', 'honeypot'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() >= 3 && request.resource.data.email.size() <= 120
                    && request.resource.data.subject in ['Design Advice', 'Order Status', 'Custom Dimensions', 'Trade Partnership', 'Returns & Warranty']
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 2000
                    && request.resource.data.status == 'new'
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.honeypot is string
                    && request.resource.data.honeypot.size() == 0;
    }
    // Orders and payments are written ONLY by Cloud Functions (Admin SDK).
    match /orders/{id} { allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin()); allow write: if false; }
    match /payments/{id} { allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin()); allow write: if false; }
    match /inventory/{id} { allow read, write: if isAdmin(); }
  }
}
